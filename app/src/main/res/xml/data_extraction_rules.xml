<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: like allowBackup="false", keeps the settings and password hash out of backups and phone-to-phone transfers. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
